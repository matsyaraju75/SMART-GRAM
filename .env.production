# ==============================================================================
# Smart Gram (గ్రామ సమస్య పరిష్కార వేదిక) - Production Environment Template
# Copy this file to .env on your production server (e.g. cPanel, AWS EC2, VPS)
# ==============================================================================

# Application Settings
APP_NAME="Smart Gram"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://smartgram.gov.in"
APP_DEFAULT_LANG="te" # Default to Telugu for rural citizens

# Production Database (Use dedicated non-root user with strong password)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="smartgram_prod"
DB_USER="smartgram_user"
DB_PASS="SecurePanchayatPassword2026!"
DB_CHARSET="utf8mb4"

# Session & Security Settings (HTTPS Enforced)
SESSION_LIFETIME=7200 # 2 hours in seconds
APP_KEY="generate-64-character-cryptographic-production-key-here"

# File Upload Policies
UPLOAD_MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# AI Advisory Engine (Human-in-the-Loop)
AI_ENABLED=true
GEMINI_API_KEY="" # Optional: Supply Gemini API key for automated bilingual advisory

# n8n Automation & Real-Time Citizen Notifications (Phase 8)
N8N_WEBHOOK_ENABLED=true
N8N_WEBHOOK_URL="https://n8n.smartgram.gov.in/webhook/smartgram"
N8N_WEBHOOK_SECRET="generate-strong-hmac-sha256-webhook-secret-key"
N8N_TIMEOUT_SECONDS=2
N8N_SIMULATE_IN_DEV=false
