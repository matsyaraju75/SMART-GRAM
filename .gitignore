# Smart Gram — .gitignore

# Environment & Credentials
.env
.env.local
.env.*.local

# Storage & Uploads (keep directory structure with .gitkeep)
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# Dependency Managers
/vendor/
/node_modules/

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and Editor Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary and Log files
*.log
*.tmp
*.bak
