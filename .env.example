# ==============================================================================
# Smart Gram (గ్రామ సమస్య పరిష్కార వేదిక) - Environment Configuration Template
# Duplicate this file as '.env' and fill in your local system credentials.
# NEVER commit the real '.env' file to Git!
# ==============================================================================

# Application Settings
APP_NAME="Smart Gram"
APP_ENV="development" # development | production
APP_DEBUG=true
APP_URL="http://localhost/smart-gram/public"
APP_DEFAULT_LANG="te" # te (Telugu) | en (English)

# Database Configuration (MySQL 8+)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="smart_gram_db"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"

# Session & Security Settings
SESSION_LIFETIME=7200 # 2 hours in seconds
APP_KEY="change-this-to-a-random-32-character-secret-key"

# File Upload Rules
UPLOAD_MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# Future AI Service Hook (Planned for Phase 7 - Leave blank for now)
AI_API_ENABLED=false
AI_API_KEY=""
AI_API_ENDPOINT=""

# n8n Automation & Webhook Integration (Phase 8)
N8N_WEBHOOK_ENABLED=false
N8N_WEBHOOK_URL="http://localhost:5678/webhook/smartgram"
N8N_WEBHOOK_SECRET="change-this-to-a-secure-n8n-webhook-secret-key"
N8N_TIMEOUT_SECONDS=2
N8N_SIMULATE_IN_DEV=true
